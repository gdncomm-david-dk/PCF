{
  "name": "ulp-approval-management",
  "version": "2.0.0",
  "description": "ULP Hub approval inbox PCF control (request- and item-level approval)",
  "private": true,
  "scripts": {
    "build": "pcf-scripts build --buildMode production",
    "build:dev": "pcf-scripts build",
    "clean": "pcf-scripts clean",
    "start": "pcf-scripts start watch",
    "typecheck": "tsc --noEmit",
    "harness": "node harness/serve.js",
    "package": "node solution/package-solution.js"
  },
  "dependencies": {
    "react": "16.14.0",
    "react-dom": "16.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.0",
    "@types/powerapps-component-framework": "^1.3.18",
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.9.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jszip": "^3.10.1",
    "pcf-scripts": "^1.51.1",
    "pcf-start": "^1.51.1",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.70.1"
  }
}
